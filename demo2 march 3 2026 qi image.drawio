        <mxCell id="ysVk-s7ko_iClBrcKvoG-1" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;b style=&quot;font-size:14px;&quot;&gt;QI TO DECREASE UNNECESSARY CHEST X-RAY&lt;br&gt;IN ACUTE ASTHMA EXACERBATION IN CHILDREN 2–18 YEARS&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="700" x="260" y="50" as="geometry" />
        </mxCell>
        <mxCell id="ysVk-s7ko_iClBrcKvoG-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=10;verticalAlign=top;align=left;" value="&lt;div style=&quot;text-align:left;padding:8px;&quot;&gt;&lt;b&gt;INCLUSION CRITERIA&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Children age 2–18 years&lt;br&gt;• Established asthma diagnosis&lt;br&gt;• Presentation consistent with acute asthma exacerbation&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="320" x="100" y="120" as="geometry" />
        </mxCell>
        <mxCell id="ysVk-s7ko_iClBrcKvoG-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=10;verticalAlign=top;align=left;" value="&lt;div style=&quot;text-align:left;padding:8px;&quot;&gt;&lt;b&gt;EXCLUSION CRITERIA&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Comorbidities: sickle cell disease, congenital heart disease,&lt;br&gt;  immunodeficiency, BPD, severe malnutrition&lt;br&gt;• First-time wheezing unrelated to prior asthma diagnosis&lt;br&gt;• Other conditions where CXR is required:&lt;br&gt;  – Physical findings suggestive of pneumonia or parenchymal&lt;br&gt;    disease (focal crackles, dullness, fever)&lt;br&gt;  – Suspicion of inhaled foreign body (sudden onset,&lt;br&gt;    unilateral decreased breath sounds)&lt;br&gt;  – Suspicion of structural complications&lt;br&gt;    (pneumothorax, pneumomediastinum)&lt;br&gt;  – Trauma, post-op&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="480" x="480" y="120" as="geometry" />
        </mxCell>
