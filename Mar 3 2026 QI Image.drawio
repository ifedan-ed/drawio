        <mxCell id="pRgEexwxrKvvUqylI0am-1" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;b style=&quot;font-size:15px;letter-spacing:1px;&quot;&gt;QI TO DECREASE UNNECESSARY CHEST X-RAY&lt;br&gt;IN ACUTE ASTHMA EXACERBATION IN CHILDREN 2–18 YEARS&lt;/b&gt;" vertex="1">
