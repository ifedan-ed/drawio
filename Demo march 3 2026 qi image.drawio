        <mxCell id="gnY04mpxMdjBhenlWdN_-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=12;verticalAlign=top;align=left;shadow=1;" value="&lt;div style=&quot;text-align:left;padding:10px;&quot;&gt;&lt;b style=&quot;font-size:12px;&quot;&gt;INCLUSION CRITERIA&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Children age 2–18 years&lt;br&gt;• Established asthma diagnosis&lt;br&gt;• Presentation consistent with acute asthma exacerbation&lt;/div&gt;" vertex="1">
