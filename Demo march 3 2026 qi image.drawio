        <mxCell id="gnY04mpxMdjBhenlWdN_-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5e6e6;strokeColor=#d4a0a0;strokeWidth=1;arcSize=10;verticalAlign=top;align=left;shadow=0;dashed=1;dashPattern=4 4;" value="&lt;div style=&quot;text-align:left;padding:8px 10px;&quot;&gt;&lt;b style=&quot;font-size:11px;color:#b85450;&quot;&gt;⚑ Other conditions where CXR is required — &lt;i&gt;obtain CXR directly:&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;font-size:11px;border-collapse:collapse;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;•&lt;/td&gt;&lt;td style=&quot;padding:3px 0;&quot;&gt;Physical findings suggestive of &lt;b&gt;pneumonia or parenchymal disease&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#666;&quot;&gt;(focal crackles, dullness, fever)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;•&lt;/td&gt;&lt;td style=&quot;padding:3px 0;&quot;&gt;Suspicion of &lt;b&gt;inhaled foreign body&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#666;&quot;&gt;(sudden onset, unilateral decreased breath sounds)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;•&lt;/td&gt;&lt;td style=&quot;padding:3px 0;&quot;&gt;Suspicion of &lt;b&gt;structural complications&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#666;&quot;&gt;(pneumothorax, pneumomediastinum)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 8px;vertical-align:top;&quot;&gt;•&lt;/td&gt;&lt;td style=&quot;padding:3px 0;&quot;&gt;&lt;b&gt;Trauma, post-op&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" vertex="1">
